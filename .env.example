NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Railway or any Postgres). Required on Vercel so logs persist.
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional extra admins (comma-separated). Farm operators are already allowlisted.
ADMIN_EMAILS=

# Google OAuth (recommended on the phone in the field)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional local password login (email must be an allowlisted operator)
AUTH_DEV_PASSWORD=

# Optional photo uploads to Vercel Blob. Locally, files go to /public/uploads.
BLOB_READ_WRITE_TOKEN=

# Optional Gemini vision for species/health suggestions
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
