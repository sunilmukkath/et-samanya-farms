NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Railway or any Postgres). Required on Vercel so logs persist.
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional extra operators (comma-separated). Sunil and Tony are already allowlisted.
ADMIN_EMAILS=
# Optional field staff (comma-separated). Can log; cannot open the ledger.
STAFF_EMAILS=

# Google OAuth (recommended on the phone in the field)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional local password login (email must be an allowlisted operator or staff)
AUTH_DEV_PASSWORD=

# Photo uploads to Vercel Blob. Required on Vercel. Locally, files go to /public/uploads.
BLOB_READ_WRITE_TOKEN=

# Optional Gemini vision + weekly brief rewrite
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional: POST /api/farm/sensor with Bearer token (pond float, pump, etc.)
FARM_SENSOR_TOKEN=

# Optional MapLibre raster tile URL for a drone/orthomosaic overlay
FARM_DRONE_TILE_URL=

# Set to 0 to hide harvest logs on the public harvest page
# PUBLIC_HARVEST_FROM_LOG=1
